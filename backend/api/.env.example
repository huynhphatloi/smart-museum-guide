# ---------------------------------------------------------------------------
# Smart Museum Guide - Backend API environment
# Copy this file to `.env` and adjust the values for your machine.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (local installation, no Docker required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_museum_guide?schema=public"

# Secret used to sign admin JWTs. Use a long random string in any real deployment.
JWT_SECRET="change-me-in-your-own-env-file"
JWT_EXPIRES_IN="12h"

# HTTP port for the API (all routes are served under /api)
PORT=3001

# Public base URL of this API. Used to build absolute media URLs.
PUBLIC_BASE_URL="http://localhost:3001"

# Base URL of the Visitor Web app. Zone QR codes encode <VISITOR_WEB_URL>/q/<ZONE_CODE>
VISITOR_WEB_URL="http://localhost:4173"

# Local media storage (relative to backend/api)
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=25

# Default language used when a requested translation does not exist
DEFAULT_LANGUAGE="vi"
# Languages offered until the AI service first reports the languages its models
# support. After that, the CMS and the visitor apps offer the AI service's list.
SUPPORTED_LANGUAGES="vi,en,ja,ko,zh,zh-hant,th,id,ms,km,lo,fil,fr,de,es,ru,it,pt,nl,pl,cs,sv,ar,hi,tr,uk"

# Comma separated list of allowed CORS origins (admin + visitor web + expo dev)
CORS_ORIGINS="http://localhost:4000,http://localhost:4173"

# Seed credentials (only used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@museum.local"
SEED_ADMIN_PASSWORD="Admin@12345"

# AI service (ai-services/, runs on Google Colab) that translates exhibit copy and
# generates narration audio. The same secret must be set in the Colab notebook; it
# signs job requests, heartbeats and result webhooks. Use 16+ random characters,
# e.g. `openssl rand -hex 24`. If unset, localization requests stay queued.
AI_SERVICE_SECRET=""
# The AI service counts as offline when no heartbeat arrived for this many seconds.
AI_SERVICE_OFFLINE_AFTER_SECONDS=90
