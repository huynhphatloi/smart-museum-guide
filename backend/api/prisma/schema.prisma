// ---------------------------------------------------------------------------
// Smart Multilingual Museum Guide - Prisma schema
//
// Core idea: physical infrastructure (Zone + Beacon + QR) is stable, while the
// exhibit shown inside a zone changes over time. `ExhibitAssignment` is the
// join that carries the time dimension, so museum staff can rotate exhibits
// without touching beacon hardware or reprinting QR codes.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Publication lifecycle of an exhibit. Only PUBLISHED exhibits are ever
/// returned to visitors through the public guide endpoints.
enum ExhibitStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Kind of media attached to an exhibit.
enum MediaType {
  IMAGE
  AUDIO
  VIDEO
}

/// Lifecycle of one translate-and-narrate task handled by the AI service
/// (`ai-services/`).
enum LocalizationStatus {
  /// Waiting: not handed to an AI service yet, or queued inside it.
  QUEUED
  /// The AI service is translating or synthesising this language.
  PROCESSING
  COMPLETED
  FAILED
  /// A newer request for the same exhibit language replaced this task.
  SUPERSEDED
}

/// How a beacon advertises its identity.
///
/// EDDYSTONE_UID is the primary protocol for this project: it is carried in BLE
/// service data under UUID 0xFEAA, which both Android and iOS expose to an
/// ordinary GATT/BLE scan - so `react-native-ble-plx` can read it identically on
/// both platforms.
///
/// IBEACON is kept because the same hardware can advertise both, and because iOS
/// exposes iBeacon through Core Location region monitoring, which is the only
/// dependable route to background detection on iPhone.
enum BeaconProtocol {
  EDDYSTONE_UID
  IBEACON
  GENERIC
}

/// What a survey point is for. Reference points build the radio map; test
/// points are held out and only ever used to measure positioning error.
enum SurveyPointKind {
  REFERENCE
  TEST
}

/// Museum staff account. Visitors never have accounts.
model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

/// A physical area of the museum. Beacons and QR codes point at zones, never
/// directly at exhibits.
model Zone {
  id          String   @id @default(uuid())
  name        String
  /// Stable human readable code, e.g. ZONE_A01. Encoded in the QR URL.
  code        String   @unique
  description String?
  floor       String?
  /// Value encoded into the printed QR code (usually <visitorWebUrl>/q/<code>).
  qrCode      String?  @unique
  /// The room plan this zone is drawn on. Null for zones not on any map yet.
  floorPlanId String?
  /// Outline on the floor plan, in metres:
  ///   {"type":"circle","x":0.3,"y":0.3,"r":1.2}
  ///   {"type":"polygon","points":[[0,0],[2,0],[2,2]]}
  mapShape    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  floorPlan   FloorPlan?          @relation(fields: [floorPlanId], references: [id], onDelete: SetNull)
  beacons     Beacon[]
  assignments ExhibitAssignment[]

  @@index([code])
  @@index([floorPlanId])
  @@map("zones")
}

/// A room plan the visitor app draws, and the coordinate system indoor
/// positioning works in: metres, origin at the top-left corner, x to the right,
/// y downwards.
model FloorPlan {
  id           String   @id @default(uuid())
  /// Stable human readable code, e.g. DEMO_ROOM.
  code         String   @unique
  name         String
  /// Free-form level label shown to visitors, e.g. "1".
  level        String?
  widthMeters  Float
  heightMeters Float
  /// Optional background drawing. Without it the app draws the room outline.
  imageUrl     String?
  /// k for weighted k-nearest-neighbours, chosen by the evaluation script.
  positioningK Int      @default(3)
  /// RSSI, in dBm, standing in for a beacon that was not heard at all, so every
  /// fingerprint vector has the same length.
  fillDbm      Int      @default(-100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  zones        Zone[]
  surveyPoints SurveyPoint[]

  @@map("floor_plans")
}

/// A spot on a floor plan where staff stood and recorded beacon signals.
model SurveyPoint {
  id          String          @id @default(uuid())
  floorPlanId String
  label       String
  /// Metres from the plan's top-left corner.
  x           Float
  y           Float
  kind        SurveyPointKind @default(REFERENCE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  floorPlan FloorPlan       @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  captures  SurveyCapture[]

  @@index([floorPlanId, kind])
  @@map("survey_points")
}

/// One recording at one survey point with one phone held one way.
///
/// Phones of different makes report RSSI with different offsets, so every
/// capture remembers the device it came from and the app prefers fingerprints
/// recorded on its own model.
model SurveyCapture {
  id             String   @id @default(uuid())
  pointId        String
  /// e.g. "iPhone 13", "Pixel 7", or "simulator" for synthetic seed data.
  deviceModel    String
  /// "ios" | "android" | "simulator".
  platform       String
  /// Which way the phone faced, in degrees; null when not recorded.
  orientationDeg Int?
  startedAt      DateTime
  durationMs     Int
  /// Raw readings, kept so the evaluation can replay them with other settings:
  /// [{"b":"BEACON_A01","r":-61,"t":123}] - t is ms since startedAt.
  samples        Json
  /// The fingerprint the phone derived from `samples`: {"BEACON_A01": -61.4}.
  fingerprint    Json
  createdAt      DateTime @default(now())

  point SurveyPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@index([pointId])
  @@index([deviceModel])
  @@map("survey_captures")
}

/// A BLE beacon physically installed in a zone.
///
/// Deliberately NOT identified by MAC address: Android reports a stable MAC as
/// the device id, but iOS reports a per-installation UUID instead, so a MAC can
/// never be a cross-platform identity. Identity comes from the advertised
/// payload - Eddystone namespace+instance, or the iBeacon uuid/major/minor
/// triple.
model Beacon {
  id         String         @id @default(uuid())
  name       String
  /// Stable logical identifier used by the mobile app and the public API,
  /// e.g. BEACON_A01. Protocol independent, and what the API resolves on.
  identifier String         @unique
  protocol   BeaconProtocol @default(EDDYSTONE_UID)

  /// Eddystone UID namespace - 10 bytes, 20 hex characters. Usually one value
  /// for the whole museum.
  namespaceId String?
  /// Eddystone UID instance - 6 bytes, 12 hex characters. One per beacon.
  instanceId  String?

  /// iBeacon proximity UUID (null for beacons that do not advertise iBeacon).
  uuid  String?
  major Int?
  minor Int?

  /// Configured transmit power in dBm. For indoor zoning this should be turned
  /// DOWN (roughly -12..-8 dBm), not up: a 200 m beacon makes zones overlap.
  txPower               Int?
  /// Configured advertising interval in milliseconds. ~500 ms is a sensible
  /// starting point - faster drains the battery, slower starves the RSSI window.
  advertisingIntervalMs Int?

  /// Smoothed RSSI, in dBm, below which the phone treats this beacon as "another
  /// room" and ignores it. This is the zone's reach, and it is deliberately NOT
  /// stored as a radius in metres: the same threshold covers a different
  /// distance in a small room, a glass-cased hall, or a crowd. Null means fall
  /// back to the app's global EXPO_PUBLIC_MIN_RSSI.
  minRssi Int?

  /// Where the beacon is mounted on its zone's floor plan, in metres from the
  /// plan's top-left corner. Used to draw it, for the nearest-beacon baseline
  /// and by the simulator - fingerprint positioning itself never needs it.
  mapX Float?
  mapY Float?

  enabled   Boolean  @default(true)
  zoneId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@unique([namespaceId, instanceId], name: "beacon_eddystone_uid")
  @@unique([uuid, major, minor], name: "beacon_ibeacon_triple")
  @@index([zoneId])
  @@map("beacons")
}

/// A museum object. Language independent - all human readable copy lives in
/// ExhibitTranslation.
model Exhibit {
  id           String        @id @default(uuid())
  code         String        @unique
  /// Internal fallback label shown in the CMS and used if no translation at all
  /// can be resolved.
  defaultTitle String
  status       ExhibitStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  translations      ExhibitTranslation[]
  media             ExhibitMedia[]
  assignments       ExhibitAssignment[]
  localizationTasks LocalizationTask[]

  @@index([status])
  @@map("exhibits")
}

/// Localised copy for one exhibit in one language. Adding a new language is a
/// data operation - never a schema change.
model ExhibitTranslation {
  id               String   @id @default(uuid())
  exhibitId        String
  /// ISO-style language code: vi, en, ja, ko, zh, fr, ...
  languageCode     String
  title            String
  shortDescription String?
  description      String?
  /// Narration audio for this language.
  audioUrl         String?
  /// Hash of the primary-language copy this row was generated from. Null for
  /// copy that was never produced by the AI service (seed data, manual edits),
  /// which the next localization request therefore regenerates.
  sourceHash       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  exhibit Exhibit @relation(fields: [exhibitId], references: [id], onDelete: Cascade)

  @@unique([exhibitId, languageCode])
  @@index([languageCode])
  @@map("exhibit_translations")
}

/// One "translate the primary copy into a language, then narrate it" request.
/// The newest row per (exhibitId, languageCode) is the status the CMS shows;
/// older rows are kept as history.
model LocalizationTask {
  id               String             @id @default(uuid())
  exhibitId        String
  languageCode     String
  sourceLanguage   String
  /// Hash of the primary copy at request time - see ExhibitTranslation.sourceHash.
  sourceHash       String
  status           LocalizationStatus @default(QUEUED)
  /// "translating" or "synthesizing" while PROCESSING.
  stage            String?
  error            String?
  /// Instance id of the AI service the task was handed to. A different live
  /// instance means that queue is gone (e.g. the Colab runtime restarted).
  dispatchedTo     String?
  dispatchedAt     DateTime?
  completedAt      DateTime?
  /// Narration file produced by this task.
  audioUrl         String?
  translationModel String?
  ttsModel         String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  exhibit Exhibit @relation(fields: [exhibitId], references: [id], onDelete: Cascade)

  @@index([exhibitId, languageCode, createdAt])
  @@index([status])
  @@map("localization_tasks")
}

/// What the AI service reported about itself in its last heartbeat that changed
/// something. A single row (id "default"): it outlives API restarts and Colab
/// downtime, so the CMS and the visitor apps keep offering the same languages.
model AiServiceProfile {
  id               String   @id @default("default")
  /// Language codes both of its models cover - the languages the museum offers.
  languages        String[]
  translationModel String?
  ttsModels        String[]
  device           String?
  lastSeenAt       DateTime
  updatedAt        DateTime @updatedAt

  @@map("ai_service_profile")
}

/// Images / audio / video attached to an exhibit (language neutral gallery).
model ExhibitMedia {
  id        String    @id @default(uuid())
  exhibitId String
  type      MediaType
  url       String
  caption   String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  exhibit Exhibit @relation(fields: [exhibitId], references: [id], onDelete: Cascade)

  @@index([exhibitId, sortOrder])
  @@map("exhibit_media")
}

/// "This exhibit is physically displayed in this zone during [activeFrom, activeTo)".
/// `activeTo == null` means open ended. Overlapping assignments inside the same
/// zone are rejected by the backend (see ScheduleConflictValidator).
model ExhibitAssignment {
  id         String    @id @default(uuid())
  zoneId     String
  exhibitId  String
  activeFrom DateTime
  activeTo   DateTime?
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  zone    Zone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  exhibit Exhibit @relation(fields: [exhibitId], references: [id], onDelete: Restrict)

  @@index([zoneId, activeFrom])
  @@index([exhibitId])
  @@map("exhibit_assignments")
}
