# Base URL of the backend API (must include the /api prefix)
# Coolify build arg: NEXT_PUBLIC_API_URL=https://api.<domain>/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Coolify / production: bake as Docker build arg, e.g. https://api.<domain>/api
# Changing this value requires rebuilding the Admin image.

# Experimental indoor map (floor plan editor and positioning tools).
# false -> the Maps page shows "coming soon" (default). Baked in at build time.
NEXT_PUBLIC_INDOOR_MAP=false
