# Coolify deploy checklist for Smart Museum Guide.
# Replace <domain> with your real domain (e.g. my-museum.org). See Deployment in README.md.

# ---------------------------------------------------------------------------
# 1. Coolify resources (one Project, four resources — NOT docker-compose)
# ---------------------------------------------------------------------------
# Postgres  : Coolify Database (PostgreSQL 16). Keep internal.
# API       : Application
#             Base Directory = backend
#             Dockerfile     = api/Dockerfile
#             Port           = 3001
#             Domain         = api.<domain>
#             Persistent storage: host path or volume → /data/uploads
#             (still recommended with MEDIA_STORAGE=r2 for media uploaded earlier)
# Admin     : Application
#             Base Directory = backend
#             Dockerfile     = admin/Dockerfile
#             Port           = 4000
#             Domain         = admin.<domain>
#             Build arg NEXT_PUBLIC_API_URL = https://api.<domain>/api
#             Optional build arg NEXT_PUBLIC_INDOOR_MAP = true (experimental map)
# Visitor   : Application
#             Base Directory = visitor-web
#             Dockerfile     = Dockerfile
#             Port           = 80
#             Domain         = guide.<domain>
#             Build arg VITE_API_URL = https://api.<domain>/api
#             Optional build arg VITE_INDOOR_MAP = true (experimental map)
#
# Do NOT deploy ai-services/ or visitor-mobile to Coolify.
# AI stays on Colab (GPU). Mobile stays Expo.

# ---------------------------------------------------------------------------
# 2. Proxy (Traefik / Coolify) — required for localization webhooks
# ---------------------------------------------------------------------------
# Max request body ≥ 40MB (base64 MP3 inside JSON)
# Proxy / read timeout ≥ 120s

# ---------------------------------------------------------------------------
# 3. API runtime environment
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/smart_museum_guide?schema=public
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=12h
PUBLIC_BASE_URL=https://api.<domain>
VISITOR_WEB_URL=https://guide.<domain>
CORS_ORIGINS=https://admin.<domain>,https://guide.<domain>
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=25
# Store uploads + AI narration in Cloudflare R2 (leave MEDIA_STORAGE=local to use /data/uploads)
MEDIA_STORAGE=r2
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-token-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-token-secret
R2_BUCKET=smart-museum-media
R2_PUBLIC_URL=https://media.<domain>
DEFAULT_LANGUAGE=vi
AI_SERVICE_SECRET=replace-with-openssl-rand-hex-24
AI_SERVICE_OFFLINE_AFTER_SECONDS=90

# ---------------------------------------------------------------------------
# 4. After first deploy
# ---------------------------------------------------------------------------
# curl https://api.<domain>/api/health
# Seed or create an admin user (seed credentials are local-dev only).
# In Colab notebook set:
#   BACKEND_API_URL = https://api.<domain>/api
#   AI_SERVICE_SECRET = same value as above
# Leave Colab PUBLIC_URL as its own tunnel; heartbeats register that URL.
