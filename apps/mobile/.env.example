# ---------------------------------------------------------------------------
# Mobile app environment (Expo reads EXPO_PUBLIC_* at build time)
# ---------------------------------------------------------------------------

# IMPORTANT: a phone cannot reach "localhost" on your laptop.
# Use your machine's LAN IP, e.g. http://192.168.1.20:3001/api
EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:3001/api

# true  -> beacon signals come from the in-app developer simulator
# false -> beacon signals come from real hardware via react-native-ble-plx
#          (requires an Expo Development Build - Expo Go cannot load native BLE)
EXPO_PUBLIC_BLE_SIMULATION=true

EXPO_PUBLIC_DEFAULT_LANGUAGE=vi

# --- BLE calibration -------------------------------------------------------
# These are starting points for one building, not universal constants.
EXPO_PUBLIC_SCAN_WINDOW_MS=4000
EXPO_PUBLIC_DWELL_TIME_MS=3000
EXPO_PUBLIC_HYSTERESIS_DB=4
# Absolute value; used as -95 dBm
EXPO_PUBLIC_MIN_RSSI=95
EXPO_PUBLIC_COOLDOWN_MS=60000
EXPO_PUBLIC_TICK_INTERVAL_MS=500
