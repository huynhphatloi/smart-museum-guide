// ---------------------------------------------------------------------------
// Smart Multilingual Museum Guide - Prisma schema
//
// Core idea: physical infrastructure (Zone + Beacon + QR) is stable, while the
// exhibit shown inside a zone changes over time. `ExhibitAssignment` is the
// join that carries the time dimension, so museum staff can rotate exhibits
// without touching beacon hardware or reprinting QR codes.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Publication lifecycle of an exhibit. Only PUBLISHED exhibits are ever
/// returned to visitors through the public guide endpoints.
enum ExhibitStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Kind of media attached to an exhibit.
enum MediaType {
  IMAGE
  AUDIO
  VIDEO
}

/// How a beacon advertises its identity.
///
/// EDDYSTONE_UID is the primary protocol for this project: it is carried in BLE
/// service data under UUID 0xFEAA, which both Android and iOS expose to an
/// ordinary GATT/BLE scan - so `react-native-ble-plx` can read it identically on
/// both platforms.
///
/// IBEACON is kept because the same hardware can advertise both, and because iOS
/// exposes iBeacon through Core Location region monitoring, which is the only
/// dependable route to background detection on iPhone.
enum BeaconProtocol {
  EDDYSTONE_UID
  IBEACON
  GENERIC
}

/// Museum staff account. Visitors never have accounts.
model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

/// A physical area of the museum. Beacons and QR codes point at zones, never
/// directly at exhibits.
model Zone {
  id          String   @id @default(uuid())
  name        String
  /// Stable human readable code, e.g. ZONE_A01. Encoded in the QR URL.
  code        String   @unique
  description String?
  floor       String?
  /// Value encoded into the printed QR code (usually <visitorWebUrl>/q/<code>).
  qrCode      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  beacons     Beacon[]
  assignments ExhibitAssignment[]

  @@index([code])
  @@map("zones")
}

/// A BLE beacon physically installed in a zone.
///
/// Deliberately NOT identified by MAC address: Android reports a stable MAC as
/// the device id, but iOS reports a per-installation UUID instead, so a MAC can
/// never be a cross-platform identity. Identity comes from the advertised
/// payload - Eddystone namespace+instance, or the iBeacon uuid/major/minor
/// triple.
model Beacon {
  id         String         @id @default(uuid())
  name       String
  /// Stable logical identifier used by the mobile app and the public API,
  /// e.g. BEACON_A01. Protocol independent, and what the API resolves on.
  identifier String         @unique
  protocol   BeaconProtocol @default(EDDYSTONE_UID)

  /// Eddystone UID namespace - 10 bytes, 20 hex characters. Usually one value
  /// for the whole museum.
  namespaceId String?
  /// Eddystone UID instance - 6 bytes, 12 hex characters. One per beacon.
  instanceId  String?

  /// iBeacon proximity UUID (null for beacons that do not advertise iBeacon).
  uuid       String?
  major      Int?
  minor      Int?

  /// Configured transmit power in dBm. For indoor zoning this should be turned
  /// DOWN (roughly -12..-8 dBm), not up: a 200 m beacon makes zones overlap.
  txPower    Int?
  /// Configured advertising interval in milliseconds. ~500 ms is a sensible
  /// starting point - faster drains the battery, slower starves the RSSI window.
  advertisingIntervalMs Int?

  /// Smoothed RSSI, in dBm, below which the phone treats this beacon as "another
  /// room" and ignores it. This is the zone's reach, and it is deliberately NOT
  /// stored as a radius in metres: the same threshold covers a different
  /// distance in a small room, a glass-cased hall, or a crowd. Null means fall
  /// back to the app's global EXPO_PUBLIC_MIN_RSSI.
  minRssi Int?

  enabled    Boolean        @default(true)
  zoneId     String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@unique([namespaceId, instanceId], name: "beacon_eddystone_uid")
  @@unique([uuid, major, minor], name: "beacon_ibeacon_triple")
  @@index([zoneId])
  @@map("beacons")
}

/// A museum object. Language independent - all human readable copy lives in
/// ExhibitTranslation.
model Exhibit {
  id           String        @id @default(uuid())
  code         String        @unique
  /// Internal fallback label shown in the CMS and used if no translation at all
  /// can be resolved.
  defaultTitle String
  status       ExhibitStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  translations ExhibitTranslation[]
  media        ExhibitMedia[]
  assignments  ExhibitAssignment[]

  @@index([status])
  @@map("exhibits")
}

/// Localised copy for one exhibit in one language. Adding a new language is a
/// data operation - never a schema change.
model ExhibitTranslation {
  id               String   @id @default(uuid())
  exhibitId        String
  /// ISO-style language code: vi, en, ja, ko, zh, fr, ...
  languageCode     String
  title            String
  shortDescription String?
  description      String?
  /// Narration audio for this language.
  audioUrl         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  exhibit Exhibit @relation(fields: [exhibitId], references: [id], onDelete: Cascade)

  @@unique([exhibitId, languageCode])
  @@index([languageCode])
  @@map("exhibit_translations")
}

/// Images / audio / video attached to an exhibit (language neutral gallery).
model ExhibitMedia {
  id        String    @id @default(uuid())
  exhibitId String
  type      MediaType
  url       String
  caption   String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  exhibit Exhibit @relation(fields: [exhibitId], references: [id], onDelete: Cascade)

  @@index([exhibitId, sortOrder])
  @@map("exhibit_media")
}

/// "This exhibit is physically displayed in this zone during [activeFrom, activeTo)".
/// `activeTo == null` means open ended. Overlapping assignments inside the same
/// zone are rejected by the backend (see ScheduleConflictValidator).
model ExhibitAssignment {
  id         String    @id @default(uuid())
  zoneId     String
  exhibitId  String
  activeFrom DateTime
  activeTo   DateTime?
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  zone    Zone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  exhibit Exhibit @relation(fields: [exhibitId], references: [id], onDelete: Restrict)

  @@index([zoneId, activeFrom])
  @@index([exhibitId])
  @@map("exhibit_assignments")
}
